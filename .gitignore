# Environment & secrets
.env*
!.env.example
nohup.out
*.pem
secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
.venv-*/
env/
.eggs/
*.egg-info/
dist/
build/

# Data — ignore runtime outputs, keep static reference files
data/raw/
data/processed/
data/cache/*
!data/cache/.gitkeep
data/graph.db
data/*.jsonl
data/images/

# graph_snapshot/ (repo root, NOT under data/) is the tracked JSON/JSONL
# source of truth for the graph — see src/storage/json_export.py and
# README.md. It lives outside data/ specifically so the broad "ignore
# runtime outputs" rules above never need special-casing to keep it
# tracked. Do not add a data/graph_snapshot/ path to this project — that
# would fall under data/*.jsonl above and be silently ignored.
!graph_snapshot/

# Logs
logs/
*.log

# IDE
.vscode/
.idea/
.cursor/
*.swp
*.swo
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Temporary
tmp/
temp/
*.tmp

# spaCy models (downloaded at runtime)
data/spacy_models/

# Graph visualization HTML outputs
graph_focused.html
graph_structural.html
index.html
