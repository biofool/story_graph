# Story Graph — Source Family / Father Yod
# Copy this file to .env and fill in your values

# ===================
# Crawling
# ===================

# Request delay between page fetches (seconds)
CRAWL_DELAY_SECONDS=3

# Maximum crawl depth from seed URLs (0 = seeds only, 1 = seeds + direct links, etc.)
CRAWL_MAX_DEPTH=2

# Maximum pages to crawl total (safety cap)
CRAWL_MAX_PAGES=200

# User agent string for HTTP requests
CRAWL_USER_AGENT=story-graph-bot/0.1 (+research)

# Request timeout (seconds)
CRAWL_TIMEOUT=30

# ===================
# NLP / Entity Extraction
# ===================

# spaCy model name (en_core_web_sm is lightweight; en_core_web_lg is more accurate)
SPACY_MODEL=en_core_web_sm

# ===================
# Gemini (Google Gen AI SDK)
# ===================

# API key from https://aistudio.google.com/apikey — optional.
# When unset, Gemini features (seed discovery, LLM extraction, graph Q&A)
# are disabled and the spaCy + rule-based pipeline runs as-is.
GEMINI_API_KEY=

# Model name. gemini-2.5-flash is a good default for speed/cost; use
# gemini-2.5-pro for higher-quality extraction.
GEMINI_MODEL=gemini-2.5-flash

# ===================
# Storage
# ===================

# SQLite database path (relative to project root)
GRAPH_DB_PATH=data/graph.db

# Raw crawled page storage directory
RAW_PAGES_DIR=data/raw
