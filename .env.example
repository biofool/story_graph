# Story Graph — Source Family / Father Yod
# Copy this file to .env and fill in your values

# ===================
# Crawling
# ===================

# Request delay between page fetches (seconds)
CRAWL_DELAY_SECONDS=3

# Maximum crawl depth from seed URLs (0 = seeds only, 1 = seeds + direct links, etc.)
CRAWL_MAX_DEPTH=2

# Maximum pages to crawl total (safety cap)
CRAWL_MAX_PAGES=200

# User agent string for HTTP requests
CRAWL_USER_AGENT=story-graph-bot/0.1 (+research)

# Request timeout (seconds)
CRAWL_TIMEOUT=30

# ===================
# NLP / Entity Extraction
# ===================

# spaCy model name (en_core_web_sm is lightweight; en_core_web_lg is more accurate)
SPACY_MODEL=en_core_web_sm

# ===================
# Gemini (Google Gen AI SDK)
# ===================

# API key from https://aistudio.google.com/apikey — optional.
# When unset, Gemini features (seed discovery, LLM extraction, graph Q&A)
# are disabled and the spaCy + rule-based pipeline runs as-is.
GEMINI_API_KEY=

# Model name. gemini-2.5-flash is a good default for speed/cost; use
# gemini-2.5-pro for higher-quality extraction.
GEMINI_MODEL=gemini-2.5-flash

# ===================
# Storage
# ===================

# SQLite database path (relative to project root)
GRAPH_DB_PATH=data/graph.db

# Raw crawled page storage directory
RAW_PAGES_DIR=data/raw

# Tracked/version-controlled JSON snapshot of the graph (source of truth —
# GRAPH_DB_PATH above is only the local SQLite working copy rebuilt from
# this at pipeline startup; see src/storage/json_export.py). Relative to
# project root.
GRAPH_SNAPSHOT_DIR=graph_snapshot

# ===================
# Meta / Facebook Graph API
# ===================

# User/Page Access Token from https://developers.facebook.com/tools/explorer/
FB_ACCESS_TOKEN=

# ===================
# CloudManagement cost controls (optional, opt-in)
# ===================

# Enable centralized cost tracking / budget gating via the CloudManagement hub.
# When false/unset (default), cost tracking is disabled and the pipeline runs
# exactly as before. Set to true to declare intents before Gemini calls and
# report actuals incrementally. Applies to both scripts/02_gemini_search.py
# (per subcommand) and scripts/03_targeted_entity_research.py (per run).
# The cloud_management_client package is vendored at src/cloud_management_client/
# (stdlib-only, no pip dependency).
CLOUDMANAGEMENT_ENABLED=false

# Base URL of the CloudManagement service (local dev default; set to the
# Cloud Run URL in production)
CLOUDMANAGEMENT_URL=http://127.0.0.1:8080

# Project ID registered in the CloudManagement hub
CLOUDMANAGEMENT_PROJECT_ID=story_graph

# Report token (SECRET — never commit or log this value).
# In production this is fetched from GCP Secret Manager under the name
# CLOUDMANAGEMENT_REPORT_TOKEN_STORY_GRAPH (project: quantum-aikido-coaching).
# For local dev, paste the value here or export it in your shell.
CLOUDMANAGEMENT_REPORT_TOKEN=

# Human-readable application name and source repo (for attribution in the hub dashboard)
CLOUDMANAGEMENT_APPLICATION=StoryGraph
CLOUDMANAGEMENT_SOURCE_REPO=biofool/story_graph

# If true, raise on hub errors instead of logging (default false — best-effort)
CLOUDMANAGEMENT_STRICT=false

# HTTP timeouts (seconds)
CLOUDMANAGEMENT_TIMEOUT=5
CLOUDMANAGEMENT_INTENT_TIMEOUT=3

# ===================
# Reddit API (Source Family discussions extraction)
# ===================

# Reddit API credentials — get these from https://www.reddit.com/prefs/apps
# Click "Create app" → Type: "script" → Redirect URI: http://localhost:8080
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StorygraphSourceFamily/1.0 by YourUsername
REDDIT_USERNAME=
REDDIT_PASSWORD=

